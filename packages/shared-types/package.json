{
  "name": "@moutar/shared-types",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./regles/*": "./src/regles/*.ts",
    "./catalogues/*": "./src/catalogues/*.ts"
  },
  "typesVersions": {
    "*": {
      "regles/*": ["src/regles/*.ts"],
      "catalogues/*": ["src/catalogues/*.ts"]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
