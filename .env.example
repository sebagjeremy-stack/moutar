# Moutar — variables d'environnement (copier en `.env` à la racine ; jamais de secret dans le code).
NODE_ENV=development
# Base PostgreSQL locale de développement (scripts/dev-db.sh : port 5433, base « moutar »). Deux chaînes :
# DATABASE_URL = l'API, avec le rôle APPLICATIF « moutar_app » (créé par dev-db.sh, droits posés par `pnpm db:droits`) ;
# DATABASE_URL_MIGRATIONS = le PROPRIÉTAIRE « moutar » (migrations, graines, db:droits). En développement, elles peuvent
# être égales ; en production, l'API refuse de démarrer avec le propriétaire (apps/api/src/config/env.ts).
DATABASE_URL=postgres://moutar_app:moutar_app@127.0.0.1:5433/moutar
DATABASE_URL_MIGRATIONS=postgres://moutar:moutar@127.0.0.1:5433/moutar
# Mot de passe du rôle applicatif, lu par `pnpm db:droits` (création ou rotation) ; jamais écrit ailleurs.
MOUTAR_APP_PASSWORD=moutar_app
PORT_API=3100
# Moteur d'IA (lot 3 : logo, OCR ; lot 4 : audio) — deux fournisseurs derrière un seul module `ia`.
# `ovh` (défaut) : OVHcloud AI Endpoints, compatible OpenAI, UE. IA_BASE_URL vide = moteur non configuré (les routes IA
# répondent 503 `moteur_non_configure`) ; l'API refuse de démarrer si l'hôte de IA_BASE_URL n'est pas dans IA_HOTES_AUTORISES.
# IA_API_KEY : le jeton OVH (vide quand un mandataire authentifie, comme dans le conteneur de développement) ; EN PRODUCTION,
# il est OBLIGATOIRE dès que IA_FOURNISSEUR=ovh et IA_BASE_URL sont posés (l'API refuse de démarrer sans).
# `anthropic` : Claude par le SDK officiel ; exige ANTHROPIC_API_KEY (sinon l'API refuse de démarrer). Jamais la clé dans le code.
IA_FOURNISSEUR=ovh
ANTHROPIC_API_KEY=
IA_MODELE_ANTHROPIC=claude-opus-5-5
IA_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
IA_API_KEY=
IA_MODELE_VISION=Qwen2.5-VL-72B-Instruct
IA_MODELE_TEXTE=gpt-oss-120b
IA_MODELE_AUDIO=whisper-large-v3-turbo
IA_HOTES_AUTORISES=oai.endpoints.kepler.ai.cloud.ovh.net
# Open Food Facts (ODbL).
OFF_BASE_URL=https://world.openfoodfacts.org
# Compte d'administration créé par `pnpm db:seed-admin` (le mot de passe est généré et affiché UNE fois).
ADMIN_EMAIL_INITIAL=admin@exemple.fr
# Lot 5 : hôtes admis pour le lien de preuve d'une contribution (https seulement ; les sous-domaines comptent). Défaut ci-dessous.
CONTRIBUTION_HOTES_PREUVE=facebook.com,lesbonsplanscachers.fr
