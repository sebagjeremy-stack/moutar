# Moutar — variables d'environnement (copier en `.env` à la racine ; jamais de secret dans le code).
NODE_ENV=development
# Base PostgreSQL locale de développement (scripts/dev-db.sh : port 5433, utilisateur et base « moutar »).
DATABASE_URL=postgres://moutar:moutar@127.0.0.1:5433/moutar
PORT_API=3100
# Moteur d'IA (lots 3 et 4) : OVHcloud AI Endpoints (compatible OpenAI) par défaut ; `anthropic` dès qu'une clé est posée.
# L'API refuse de démarrer si l'hôte de IA_BASE_URL n'est pas dans IA_HOTES_AUTORISES.
IA_FOURNISSEUR=ovh
ANTHROPIC_API_KEY=
IA_BASE_URL=
IA_MODELE_VISION=
IA_MODELE_TEXTE=
IA_HOTES_AUTORISES=oai.endpoints.kepler.ai.cloud.ovh.net
# Open Food Facts (ODbL).
OFF_BASE_URL=https://world.openfoodfacts.org
# Compte d'administration créé par `pnpm db:seed-admin` (le mot de passe est généré et affiché UNE fois).
ADMIN_EMAIL_INITIAL=admin@exemple.fr
