# /srv/moutar/.env.prod — l'environnement de PRODUCTION, à copier sur le serveur (mode 600 ; jamais dans le dépôt :
# `.env.*` est ignoré par git). Les valeurs ci-dessous sont des exemples ou des vides : aucune valeur secrète ici.
# Une ligne VIDE vaut absente (`VARIABLE=`) : c'est ainsi qu'on éteint un réglage.
# Ce fichier liste TOUTES les variables lues par l'API (apps/api/src/config/env.ts) : `env-prod-example.spec.ts` échoue
# si l'une manque. Posées par deploy/docker-compose.yml, PAS ici (commentées pour mémoire) : NODE_ENV, PORT_API, TZ,
# DATABASE_URL, DATABASE_URL_MIGRATIONS — construites à partir de POSTGRES_PASSWORD et MOUTAR_APP_PASSWORD.

# ─── Site ──────────────────────────────────────────────────────────────────────────────────────────────────────────────

# Adresse publique (HTTPS automatique par Caddy, Let's Encrypt) et contact ACME. Le nom de domaine reste À DÉCIDER.
DOMAINE=moutar.exemple.fr
ACME_EMAIL=contact@exemple.fr

# ─── Base PostgreSQL (conteneur db) ────────────────────────────────────────────────────────────────────────────────────

# Mot de passe du PROPRIÉTAIRE `moutar` (migrations, graines, db:droits — jamais l'API). Tiré au hasard sur le serveur :
# openssl rand -hex 24
POSTGRES_PASSWORD=remplace-moi
# Mot de passe du rôle APPLICATIF `moutar_app` (celui de l'API). deploy/scripts/deployer.sh le tire et l'ajoute ici s'il
# manque ; le service `migrate` crée le rôle avec (apps/api/src/database/droits-application.ts).
# MOUTAR_APP_PASSWORD=
# Les deux chaînes de connexion sont construites par le compose ; ne pas les poser ici.
# DATABASE_URL=
# DATABASE_URL_MIGRATIONS=
# Posés par le compose : NODE_ENV=production, PORT_API=3100.
# NODE_ENV=
# PORT_API=

# ─── Moteur d'IA (lot 3 : logo, OCR ; lot 4 : audio) ──────────────────────────────────────────────────────────────────

# `ovh` (défaut) : OVHcloud AI Endpoints, compatible OpenAI, UE. En production, IA_API_KEY est OBLIGATOIRE dès que
# IA_BASE_URL est posée (l'API refuse de démarrer sans) ; l'hôte de IA_BASE_URL doit être dans IA_HOTES_AUTORISES.
# `anthropic` : Claude par le SDK officiel ; exige ANTHROPIC_API_KEY. Jamais une clé dans le code ni dans le dépôt.
IA_FOURNISSEUR=ovh
IA_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
IA_API_KEY=remplace-moi
IA_HOTES_AUTORISES=oai.endpoints.kepler.ai.cloud.ovh.net
IA_MODELE_VISION=Qwen2.5-VL-72B-Instruct
IA_MODELE_TEXTE=gpt-oss-120b
IA_MODELE_AUDIO=whisper-large-v3-turbo
ANTHROPIC_API_KEY=
IA_MODELE_ANTHROPIC=claude-opus-5-5

# ─── Sources et contributions ─────────────────────────────────────────────────────────────────────────────────────────

# Open Food Facts (ODbL, attribution affichée).
OFF_BASE_URL=https://world.openfoodfacts.org
# Hôtes admis pour le lien de preuve d'une contribution (https seulement ; les sous-domaines comptent).
CONTRIBUTION_HOTES_PREUVE=facebook.com,lesbonsplanscachers.fr

# ─── Console d'administration ─────────────────────────────────────────────────────────────────────────────────────────

# Compte créé par la graine (mot de passe aléatoire affiché UNE fois) :
#   docker compose --env-file /srv/moutar/.env.prod run --rm migrate ./node_modules/.bin/tsx src/database/seed-admin.ts
ADMIN_EMAIL_INITIAL=admin@exemple.fr
